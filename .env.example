# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Which ChatService implementation the UI uses: "mock" (default, no network
# calls, no key required) or "openrouter" (calls /api/chat, which requires
# OPENROUTER_API_KEY below). Not a secret — safe to expose to the client.
NEXT_PUBLIC_AI_PROVIDER=mock

# OpenRouter (server-only — never prefix this with NEXT_PUBLIC_).
# Required only when NEXT_PUBLIC_AI_PROVIDER=openrouter.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=openrouter/free

# Used as the HTTP-Referer header on OpenRouter requests. Not a secret.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: financial data API key. Currently unused — FinanceService
# (src/lib/finance/index.ts) reads this but only ever returns mock data.
# Leave blank unless a real financial data provider is wired in.
FINANCIAL_API_KEY=
