# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production / build output
/build
/dist

# misc
.DS_Store
*.pem

# debug / logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/
*.log

# env files (never commit real env values; .env.example is the exception)
.env
.env.local
.env.*.local
.env.development
.env.development.local
.env.production
.env.production.local
.env.test
.env.test.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE / editor
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# OS-generated files
Thumbs.db
Thumbs.db:encryptstream
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# temporary files
*.tmp
*.temp
.cache/
